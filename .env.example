# Target repository or organization URL (e.g. https://github.com/owner/repo or https://github.com/org)
REPO_URL=https://github.com/mukeshv-tech/Taskrebulid

# GitHub Personal Access Token (classic with 'repo' scope or fine-grained with Actions:read/write)
# Used to dynamically generate short-lived runner registration tokens on start/restart
GH_TOKEN=

# Manual fallback token if GH_TOKEN is not provided
RUNNER_TOKEN=

# Runner configuration
RUNNER_NAME=github-runner
RUNNER_LABELS=docker,self-hosted,linux
RUNNER_REPLACE=true
RUNNER_EPHEMERAL=false
